{
  "name": "@jaswantsandhu/lumina",
  "version": "0.2.0",
  "description": "Lumina: design tokens and accessible React components.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaswantsandhu/lumina.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup && node scripts/build-css.mjs",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "storybook": "npm run tokens && storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "npm run tokens && storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "highcharts": ">=11",
    "highcharts-react-official": ">=3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "storybook": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "highcharts": "^11.4.8",
    "highcharts-react-official": "^3.2.1",
    "@storybook/manager-api": "^8.4.7",
    "@storybook/theming": "^8.4.7"
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1"
  },
  "peerDependenciesMeta": {
    "highcharts": {
      "optional": true
    },
    "highcharts-react-official": {
      "optional": true
    }
  }
}
